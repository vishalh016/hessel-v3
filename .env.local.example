# ============================================================
# HESSEL — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ============================================================

# ── Supabase (public — safe to expose to browser) ───────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase (secret — server-side only) ────────────────────
# Get from: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin authentication ─────────────────────────────────────
# Generate with: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=your-bcrypt-hash

# ── JWT (for admin sessions) ─────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-64-char-random-hex-secret

# ── Cloudinary (public) ──────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ── Cloudinary (secret — server-side only) ──────────────────
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Contact / WhatsApp ───────────────────────────────────────
# Format: country code + number, no spaces or +
# e.g. India +91 98765 43210 → 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# ── Social links ─────────────────────────────────────────────
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/hessel
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/hessel
